generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "mysql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

enum ITkerusRole {
  DEVELOPER
  PLANNER
  DESIGNER
  MARKETER
  OPERATOR
  USER_TESTER
}

enum SocialProvider {
  APPLE
  KAKAO
}

model User {
  id                    String       @id @default(uuid()) @db.Char(36)
  nickname              String?      @unique @db.VarChar(10)
  introduction          String?      @db.VarChar(60)
  primaryRole           ITkerusRole?
  isOnboardingCompleted Boolean      @default(false)
  createdAt             DateTime     @default(now()) @db.DateTime(3)
  updatedAt             DateTime     @updatedAt @db.DateTime(3)

  socialAccounts SocialAccount[]
  secondaryRoles UserSecondaryRole[]
}

model SocialAccount {
  id             String         @id @default(uuid()) @db.Char(36)
  provider       SocialProvider
  providerUserId String         @db.VarChar(191)
  userId         String         @db.Char(36)
  createdAt      DateTime       @default(now()) @db.DateTime(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@unique([userId, provider])
  @@index([userId])
}

model UserSecondaryRole {
  id        String      @id @default(uuid()) @db.Char(36)
  userId    String      @db.Char(36)
  role      ITkerusRole
  createdAt DateTime    @default(now()) @db.DateTime(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@index([userId])
}
