generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "mysql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

enum ITkerusRole {
  DEVELOPER
  PLANNER
  DESIGNER
  MARKETER
  OPERATOR
  USER_TESTER
}

enum SocialProvider {
  APPLE
  KAKAO
}

enum ProjectStatus {
  IN_DEVELOPMENT
  RELEASED
}

enum ProjectPurpose {
  INTRODUCTION
  QUESTION
}

enum ProjectLinkType {
  APP_STORE
  GOOGLE_PLAY
  WEB
}

model User {
  id                    String       @id @default(uuid()) @db.Char(36)
  nickname              String?      @unique @db.VarChar(10)
  introduction          String?      @db.VarChar(60)
  primaryRole           ITkerusRole?
  isOnboardingCompleted Boolean      @default(false)
  termsAcceptedAt       DateTime?    @db.DateTime(3)
  privacyAcceptedAt     DateTime?    @db.DateTime(3)
  createdAt             DateTime     @default(now()) @db.DateTime(3)
  updatedAt             DateTime     @updatedAt @db.DateTime(3)

  socialAccounts SocialAccount[]
  secondaryRoles UserSecondaryRole[]
  projectPosts   ProjectPost[]
  itkerusNotes   ITkerusNote[]
}

model SocialAccount {
  id             String         @id @default(uuid()) @db.Char(36)
  provider       SocialProvider
  providerUserId String         @db.VarChar(191)
  userId         String         @db.Char(36)
  createdAt      DateTime       @default(now()) @db.DateTime(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@unique([userId, provider])
  @@index([userId])
}

model UserSecondaryRole {
  id        String      @id @default(uuid()) @db.Char(36)
  userId    String      @db.Char(36)
  role      ITkerusRole
  createdAt DateTime    @default(now()) @db.DateTime(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@index([userId])
}

model ProjectPost {
  id               String        @id @default(uuid()) @db.Char(36)
  authorId         String        @db.Char(36)
  title            String        @db.VarChar(50)
  summary          String        @db.VarChar(120)
  story            String        @db.Text
  status           ProjectStatus
  itkerusFocus     String?       @db.VarChar(150)
  iconUrl          String?       @db.VarChar(2048)
  selectedImageUrl String?       @db.VarChar(2048)
  deletedAt        DateTime?     @db.DateTime(3)
  createdAt        DateTime      @default(now()) @db.DateTime(3)
  updatedAt        DateTime      @updatedAt @db.DateTime(3)

  author         User                   @relation(fields: [authorId], references: [id], onDelete: Restrict)
  purposes       ProjectPostPurpose[]
  requestedRoles ProjectRequestedRole[]
  links          ProjectLink[]
  images         ProjectImage[]
  notes          ITkerusNote[]

  @@index([authorId, createdAt])
  @@index([deletedAt, createdAt, id])
  @@index([status, deletedAt, createdAt])
}

model ProjectPostPurpose {
  projectId String         @db.Char(36)
  purpose   ProjectPurpose
  createdAt DateTime       @default(now()) @db.DateTime(3)

  project ProjectPost @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([projectId, purpose])
  @@index([purpose, projectId])
}

model ProjectRequestedRole {
  projectId String      @db.Char(36)
  role      ITkerusRole
  createdAt DateTime    @default(now()) @db.DateTime(3)

  project ProjectPost @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([projectId, role])
  @@index([role, projectId])
}

model ProjectLink {
  id        String          @id @default(uuid()) @db.Char(36)
  projectId String          @db.Char(36)
  type      ProjectLinkType
  url       String          @db.VarChar(2048)
  position  Int             @db.UnsignedSmallInt
  createdAt DateTime        @default(now()) @db.DateTime(3)

  project ProjectPost @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, type])
  @@index([projectId, position])
}

model ProjectImage {
  id        String   @id @default(uuid()) @db.Char(36)
  projectId String   @db.Char(36)
  url       String   @db.VarChar(2048)
  position  Int      @db.UnsignedSmallInt
  createdAt DateTime @default(now()) @db.DateTime(3)

  project ProjectPost @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, url])
  @@index([projectId, position])
}

model ITkerusNote {
  id              String      @id @default(uuid()) @db.Char(36)
  projectId       String      @db.Char(36)
  authorId        String      @db.Char(36)
  authorRole      ITkerusRole
  content         String      @db.VarChar(600)
  didTryProject   Boolean     @default(false)
  isMarkedHelpful Boolean     @default(false)
  deletedAt       DateTime?   @db.DateTime(3)
  createdAt       DateTime    @default(now()) @db.DateTime(3)
  updatedAt       DateTime    @updatedAt @db.DateTime(3)

  project ProjectPost @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author  User        @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@unique([projectId, authorId])
  @@index([projectId, deletedAt, createdAt])
  @@index([authorId, deletedAt, createdAt])
}
